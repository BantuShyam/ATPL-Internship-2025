<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	version="3.1">

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>
	  <servlet>
		<servlet-name>Cricket</servlet-name>
		<servlet-class>com.aaslin.servlets.PrintUser</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>Cricket</servlet-name>
		<url-pattern>/PrintUser</url-pattern>
	</servlet-mapping>
	  <filter>
      <filter-name>filter</filter-name>
      <filter-class>com.aaslin.filters.UserFilterServlet</filter-class>
  </filter>
  
  <filter-mapping>
      <filter-name>filter</filter-name>
      <url-pattern>/UserDetails</url-pattern>
  </filter-mapping>
  <welcome-file-list>
		<welcome-file>Filter.html</welcome-file>
	</welcome-file-list>
	<welcome-file-list>
		<welcome-file>Filter.html</welcome-file>
	</welcome-file-list>
	  <servlet>
		<servlet-name>Role</servlet-name>
		<servlet-class>com.aaslin.filters.UserDetails</servlet-class>
	</servlet>
	<servlet-mapping>
	<servlet-name>Role</servlet-name>
		<url-pattern>/UserDetails</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>Storage</servlet-name>
		<servlet-class>com.aaslin.filters.StorageServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>Storage</servlet-name>
		<url-pattern>/StorageServlet</url-pattern>
	</servlet-mapping>
	  <filter>
      <filter-name>filter2</filter-name>
      <filter-class>com.aaslin.filters.UserFilterServlet</filter-class>
  </filter>
  <filter-mapping>
      <filter-name>filter2</filter-name>
      <url-pattern>/StorageServlet</url-pattern>
  </filter-mapping>
</web-app>
